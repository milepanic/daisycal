# Same-origin path under which the Radicale CalDAV server is reachable.
# In development Vite proxies it (vite.config.ts); in production nginx does.
VITE_DAV_BASE=/dav

# Development only: where the Vite proxy forwards /dav requests.
DAV_PROXY_TARGET=http://localhost:5232

# Development only: credentials the Vite proxy sends to the local Radicale (docker/radicale/users).
DAV_PROXY_USER=daisy
DAV_PROXY_PASSWORD=daisy
