# Radicale configuration for local development (docker-compose.dev.yml).

[server]
hosts = 0.0.0.0:5232

[auth]
type = htpasswd
htpasswd_filename = /config/users
htpasswd_encryption = bcrypt

[rights]
type = owner_only

[storage]
filesystem_folder = /var/lib/radicale/collections

[web]
type = internal

[logging]
level = info
